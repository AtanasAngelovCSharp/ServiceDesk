@model ServiceDesk.ViewModels.ServiceRequests.ServiceRequestDetailsViewModel

@{
    ViewData["Title"] = "Детайли";
}

<h1>@Model.Title</h1>

<dl class="row">
    <dt class="col-sm-3">Описание</dt>
    <dd class="col-sm-9">@Model.ProblemDescription</dd>

    <dt class="col-sm-3">Статус</dt>
    <dd class="col-sm-9">
        <partial name="_StatusBadge" model="Model.Status" />
    </dd>

    <dt class="col-sm-3">Техник</dt>
    <dd class="col-sm-9">@(Model.TechnicianName ?? "Неразпределена")</dd>

    <dt class="col-sm-3">Устройство</dt>
    <dd class="col-sm-9">@Model.Device</dd>

    <dt class="col-sm-3">Клиент</dt>
    <dd class="col-sm-9">@Model.CustomerName</dd>

    <dt class="col-sm-3">Създадена</dt>
    <dd class="col-sm-9">@Model.CreatedOn</dd>

    <dt class="col-sm-3">Завършена</dt>
    <dd class="col-sm-9">@(Model.CompletedOn ?? "—")</dd>

    <dt class="col-sm-3">Цена</dt>
    <dd class="col-sm-9">@Model.EstimatedPrice.ToString("F2") €</dd>
</dl>

<a asp-action="Index" class="btn btn-secondary">Назад</a>
<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Редакция</a>
<a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Изтрий</a>