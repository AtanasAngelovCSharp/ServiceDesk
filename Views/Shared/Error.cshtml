@model ErrorViewModel
@{
    ViewData["Title"] = "Грешка";
}

<h1 class="text-danger">Грешка.</h1>
<h2 class="text-danger">Възникна грешка при обработването на вашата заявка</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Номер на заявката:</strong> <code>@Model.RequestId</code>
    </p>
}