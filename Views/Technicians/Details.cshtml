@model ServiceDesk.ViewModels.Technicians.TechnicianDetailsViewModel
@{
    ViewData["Title"] = "Техник";
}

<h1>@Model.FullName</h1>

<dl class="row">
    <dt class="col-sm-3">Специализация</dt>
    <dd class="col-sm-9">@(Model.Specialization ?? "—")</dd>
    <dt class="col-sm-3">Телефон</dt>
    <dd class="col-sm-9">@Model.PhoneNumber</dd>
</dl>

<h4>Заявки</h4>
@if (!Model.Requests.Any())
{
    <p class="text-muted">Техникът няма заявки.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Заглавие</th>
                <th>Устройство</th>
                <th>Статус</th>
                <th>Създадена</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var request in Model.Requests)
            {
                <tr>
                    <td>
                        <a asp-controller="ServiceRequests" asp-action="Details" asp-route-id="@request.Id">@request.Title</a>
                    </td>
                    <td>@request.Device</td>
                    <td>
                        <partial name="_StatusBadge" model="request.Status" />
                    </td>
                    <td>@request.CreatedOn</td>
                </tr>
            }
        </tbody>
    </table>
}

<a asp-action="Index" class="btn btn-secondary">Назад</a>
<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Редакция</a>